# Salin file ini menjadi `.env.local` dan sesuaikan bila perlu.
# TIDAK ADA SECRET yang dibutuhkan: provider default (Yahoo Finance chart API)
# bersifat publik dan tidak memerlukan API key/token/password.

# Provider data saham yang aktif. Default: yahoo
# Nilai yang didukung saat ini: yahoo
STOCK_PROVIDER=yahoo

# Base URL endpoint Yahoo Finance chart (opsional, untuk override/testing).
YAHOO_CHART_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart

# Suffix bursa untuk ticker IDX (opsional). Default: .JK
IDX_MARKET_SUFFIX=.JK

# Timeout request ke provider dalam milidetik (opsional). Default: 15000
STOCK_REQUEST_TIMEOUT_MS=15000
